ETAPA 6 — Criar o servidor Node.js
Abra o arquivo server.js e coloque:

const express = require("express");
const path = require("path");

const app = express();
const PORTA = 80;

app.use(express.urlencoded({ extended: false }));
app.use(express.json());

app.set("view engine", "ejs");
app.set("views", path.join(__dirname, "views"));

app.use(express.static(path.join(__dirname, "public")));

app.get("/", (req, res) => {
    res.send("Servidor funcionando!");
});

app.listen(PORTA, () => {
    console.log("Servidor funcionando na porta " + PORTA);
});



Para que serve cada comando?
Código	Função
require("express")	Importa o Express
require("path")	Trabalha com caminhos de arquivos
express()	Cria a aplicação
express.urlencoded()	Recebe dados de formulários
express.json()	Recebe dados JSON
app.set("view engine", "ejs")	Configura o EJS
express.static()	Disponibiliza CSS, imagens e outros arquivos
app.get()	Cria uma rota GET
app.listen()	Inicia o servidor

